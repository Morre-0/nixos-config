# 1. ЗАПУСК ПРОГРАММ
# Запуск терминала Alacritty (Super + Enter)
super + Return
    alacritty

# Запуск Zen Browser (Super + B)
super + b
    zen

# Меню приложений Rofi (Super + R)
super + r
    rofi -show drun

# Селектор обоев через Rofi (Super + W)
super + w
    ~/.config/scripts/rofi-wallpaper.sh

# 2. УПРАВЛЕНИЕ ОКНАМИ
# Закрыть текущее окно (Super + Q)
super + q
    bspc node -c

# Переключить окно в плавающий режим (Super + Space)
super + space
    bspc node -t \~floating

# Развернуть окно на весь экран (Super + F)
super + f
    bspc node -t toggle_fullscreen

# Выход из BSPWM назад в экран входа SDDM (Super + Shift + E)
super + shift + e
    bspc quit

# Перемещение фокуса между окнами (Super + Стрелочки)
super + {Left,Down,Up,Right}
    bspc node -f {west,south,north,east}

# 3. ИСПРАВЛЕНО: УПРАВЛЕНИЕ РАБОЧИМИ СТОЛАМИ (TAGS 1-5)
# Переключение на рабочий стол (Super + Цифра от 1 до 5)
super + {1,2,3,4,5}
    bspc desktop -f {1,2,3,4,5}

# Перенос активного окна на другой рабочий стол (Super + Shift + Цифра от 1 до 5)
super + shift + {1,2,3,4,5}
    bspc node -d {1,2,3,4,5}

